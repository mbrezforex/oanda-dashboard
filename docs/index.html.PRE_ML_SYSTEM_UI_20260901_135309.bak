<section id="journal" class="view"><div class="sectiontitle"><h2>Trade Journal</h2><span>OANDA closed trades</span></div><div class="card tablecard"><div class="tools"><input id="search" placeholder="Search pair, ID, directionÃ¢â‚¬Â¦"><select id="limit"><option>25</option><option selected>50</option><option>100</option><option>250</option></select></div><div class="desktopjournal tablewrap"><table><thead><tr><th>ID</th><th>Pair</th><th>Dir</th><th>Open</th><th>Close</th><th>Entry</th><th>Exit</th><th>Pips</th><th>P/L</th><th>Units</th></tr></thead><tbody id="tbody"></tbody></table></div><div id="mobilejournal" class="mobilejournal"></div></div></section>
<section id="system" class="view"><div class="sectiontitle"><h2>System</h2><span>Frozen G2 configuration</span></div><div class="grid twocol"><div class="card"><div class="kicker">Strategy</div><div id="strategy" class="health"></div></div><div class="card"><div class="kicker">Runtime</div><div id="runtime" class="health"></div></div></div></section>
<div class="footer">Read-only dashboard. No OANDA credentials are published to GitHub. Test-C Generation 2 practice monitoring.</div>
</div>
<script>
let DATA=null, NEWS=null, charts={};const $=s=>document.querySelector(s), fmt=(n,d=2)=>Number(n??0).toLocaleString(undefined,{minimumFractionDigits:d,maximumFractionDigits:d}), money=n=>`${Number(n||0)<0?'-$':'$'}${fmt(Math.abs(Number(n||0)),2)}`, cls=n=>Number(n)>0?'pos':Number(n)<0?'neg':'', esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
function when(s){if(!s)return'Ã¢â‚¬â€';try{return new Date(s).toLocaleString([], {month:'short',day:'2-digit',hour:'2-digit',minute:'2-digit'})}catch{return s}}
function metric(label,value,sub='',c=''){return `<div class="card metric"><div class="label">${label}</div><div class="value ${c}">${value}</div><div class="sub">${sub}</div></div>`}
function barCard(title,value,max,sub,color=''){const p=Math.max(0,Math.min(100,max?value/max*100:0));return `<div class="card"><div class="kicker">${title}</div><div class="metric"><div class="value">${money(value)}</div></div><div class="bar ${color}"><i style="width:${p}%"></i></div><div class="riskline"><span>${sub}</span><strong>${p.toFixed(1)}%</strong></div></div>`}
function row(a,b,c=''){return `<div class="healthrow"><span>${a}</span><strong class="${c}">${b}</strong></div>`}
function draw(id,type,labels,values,label,colors){if(charts[id])charts[id].destroy();const ctx=document.getElementById(id);if(!ctx)return;charts[id]=new Chart(ctx,{type,data:{labels,datasets:[{label,data:values,borderColor:colors||'#3bc7ff',backgroundColor:type==='line'?'rgba(59,199,255,.12)':(colors||'#3bc7ff'),fill:type==='line',tension:.28,borderWidth:2,pointRadius:type==='line'?1:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:'#8097b3',maxTicksLimit:8},grid:{color:'rgba(255,255,255,.04)'}},y:{ticks:{color:'#8097b3'},grid:{color:'rgba(255,255,255,.05)'}}}}})}

function sigNum(v,d=0){const n=Number(v);return Number.isFinite(n)?n:d}
function sigClamp(v){return Math.max(0,Math.min(100,sigNum(v,0)))}
function sigStageClass(level){const n=sigNum(level);if(n===9)return'alert';if(n>=5)return'triggered';if(n===4)return'close';if(n>=1)return'watch';return'far'}
function sigIndicator(label,x,bias){
    x=x||{};
    const v=Number(x.value),t=Number(x.threshold);
    const vt=Number.isFinite(v)?v.toFixed(4):'?';
    const tt=Number.isFinite(t)?t.toFixed(4):'?';
    const flag=x.hook?`${esc(x.hook)} hook`:(x.extreme?'EXTREME':'waiting');
    return `<div class="sigind"><span>${label}</span><strong>${vt}</strong><span class="sigthreshold">${esc(bias)} threshold ${tt}</span><span class="sigflag ${x.extreme?'good':''}">${flag}</span></div>`
}
function renderSignalMonitor(){
    const box=$('#signalmonitor');
    if(!box)return;
    const m=DATA?.signal_monitor||{};
    if(!m.snapshot_present){
        box.innerHTML=`<div class="card"><div class="kicker">Test-C Signal Monitor</div><div class="empty">Waiting for the first read-only health snapshot</div></div>`;
        return;
    }
    const age=Number(m.snapshot_age_minutes);
    const stale=!Number.isFinite(age)||age>30;
    const health=stale?'STALE':String(m.health||'UNKNOWN').toUpperCase();
    const e=m.engine||{},c=m.exact_a0_24h||{},pairs=(m.top_pairs||[]).slice(0,7);
    const rows=pairs.map((p,i)=>{
        const score=sigClamp(p.setup_score),klass=sigStageClass(p.level);
        const side=p.bias_inferred?`Nearest ${p.bias||'?'}`:(p.bias||'?');
        return `<div class="signalrow"><div class="signalrank">${i+1}</div><div class="signalpair"><strong>${esc(p.pair||'?')}</strong><span>${esc(side)}</span></div><div class="signalstage"><strong class="${klass}">${esc(p.stage||'FAR')}</strong><small>${esc(p.why||'')}</small></div><div class="sigscore"><div class="sigtrack"><div class="sigfill ${klass}" style="width:${score}%"></div></div><b>${score.toFixed(0)}</b></div></div>`
    }).join('');
    const detail=pairs.slice(0,3).map(p=>{
        const x=p.indicators||{},side=p.bias_inferred?`Nearest ${p.bias||'?'}`:(p.bias||'?');
        const rem=Number.isFinite(Number(p.minutes_remaining))?`${sigNum(p.minutes_remaining).toFixed(0)}m left`:'';
        const slope=Number.isFinite(Number(p.m15_slope))?sigNum(p.m15_slope).toFixed(8):'?';
        return `<div class="signaldetail"><div class="sigdetailhead"><div><strong>${esc(p.pair||'?')}</strong><span>${esc(side)} ? ${esc(p.stage||'FAR')}</span></div><div class="sigdetailscore">${sigClamp(p.setup_score).toFixed(0)}</div></div>${sigIndicator('RSI(3)',x.rsi3,p.bias)}${sigIndicator('RSI(5)',x.rsi5,p.bias)}${sigIndicator('ROC(4)',x.roc4,p.bias)}<div class="sigfooter"><span>M15 slope <strong>${slope}</strong></span><span>${p.slope_needed?`Waiting for ${esc(p.slope_needed)} zero-cross ${rem?`? ${rem}`:''}`:esc(p.why||'')}</span></div></div>`
    }).join('');
    box.innerHTML=`<div class="sectiontitle"><div><h2>Test-C Signal Monitor</h2><span>Read-only diagnostics ? setup score is not a probability</span></div><div class="signalstatus ${health.toLowerCase()}"><strong>${esc(health)}</strong><small>${when(m.generated_at)}</small></div></div><div class="card"><div class="signalsummary"><div><span>Exact signals ? 24h</span><strong>${sigNum(c.eligible)}</strong></div><div><span>Opened</span><strong>${sigNum(c.opened)}</strong></div><div><span>Rejected</span><strong>${sigNum(c.rejected)}</strong></div><div><span>Missed / stale</span><strong class="${sigNum(c.unseen_stale)>0?'neg':'pos'}">${sigNum(c.unseen_stale)}</strong></div><div><span>Pairs evaluated</span><strong>${sigNum(e.pairs_evaluated)} / ${sigNum(e.pair_count,26)}</strong></div><div><span>Snapshot age</span><strong>${Number.isFinite(age)?age.toFixed(1)+'m':'?'}</strong></div></div><div class="signalcols"><div class="signalwatch"><div class="signaltitle"><strong>Pairs Closest to Entry</strong><span>Stage first ? threshold distance second</span></div>${rows||'<div class="empty">No pair diagnostics available</div>'}</div><div class="signaldetails">${detail||'<div class="empty">No setup detail available</div>'}</div></div></div>`
}



function newsNum(v,d=0){
    const n=Number(v);
    return Number.isFinite(n)?n:d;
}

function newsMaybe(
    v,
    d=2,
    suffix=''
){
    const n=Number(v);

    return Number.isFinite(n)
        ? fmt(n,d)+suffix
        : '?';
}

function newsDuration(sec){

    const n=Math.max(
        0,
        Math.floor(
            newsNum(sec,0)
        )
    );

    const m=Math.floor(
        n/60
    );

    const s=n%60;

    return (
        m+'m '
        +String(s).padStart(2,'0')
        +'s'
    );
}


/* NEWS_G2_DECISION_JS_V1 */

function newsDecisionMaybe(v,d=2,suffix=''){
    if(
        v === null ||
        v === undefined ||
        v === ''
    ){
        return '--';
    }

    const n=Number(v);

    if(Number.isFinite(n)){
        return fmt(n,d)+suffix;
    }

    return esc(v);
}


function newsDecisionSnapshot(n){

    const explicit =
        n.latest_decision ||
        (
            Array.isArray(n.decisions) &&
            n.decisions.length
                ? n.decisions[n.decisions.length-1]
                : null
        );

    if(explicit){
        return explicit;
    }


    const active =
        n.active_trade ||
        n.runtime?.active_trade ||
        null;

    if(active){

        const md=active.metadata||{};

        return {
            decision_time_utc:
                active.open_time_utc ||
                active.open_time ||
                md.feed_received_utc,

            scheduled_time_utc:
                md.scheduled_time_utc,

            currency:
                md.currency,

            event_name:
                md.event_name,

            actual:
                md.actual,

            forecast:
                md.forecast,

            previous:
                md.previous,

            surprise:
                md.surprise,

            currency_bias:
                md.currency_bias,

            selected_pair:
                active.instrument,

            side:
                active.side,

            entry_spread_pips:
                md.entry_spread_pips,

            price_age_ms:
                md.price_age_ms,

            schedule_to_detection_ms:
                md.schedule_to_detection_ms,

            decision_ms:
                md.decision_ms,

            order_request_ms:
                active.order_request_ms,

            ml_status:
                md.ml_status || "NOT ACTIVE YET",

            predicted_mfe_pips:
                md.predicted_mfe_pips,

            ml_threshold_pips:
                md.ml_threshold_pips,

            ml_gate:
                md.ml_gate,

            decision:
                "TRADE",

            reason:
                "Practice trade filled and currently open"
        };
    }


    const orders=(n.orders||[]).slice().reverse();

    if(orders.length){

        const o=orders[0]||{};
        const md=o.metadata||{};
        const status=String(
            o.status ||
            o.order_status ||
            ''
        ).toUpperCase();

        return {
            decision_time_utc:
                o.time_utc ||
                o.created_utc ||
                o.open_time_utc ||
                md.feed_received_utc,

            scheduled_time_utc:
                md.scheduled_time_utc,

            currency:
                md.currency,

            event_name:
                md.event_name,

            actual:
                md.actual,

            forecast:
                md.forecast,

            previous:
                md.previous,

            surprise:
                md.surprise,

            currency_bias:
                md.currency_bias,

            selected_pair:
                o.instrument ||
                md.selected_pair,

            side:
                o.side ||
                md.side,

            entry_spread_pips:
                md.entry_spread_pips,

            price_age_ms:
                md.price_age_ms,

            schedule_to_detection_ms:
                md.schedule_to_detection_ms,

            decision_ms:
                md.decision_ms,

            order_request_ms:
                o.order_request_ms,

            ml_status:
                md.ml_status ||
                "NOT ACTIVE YET",

            predicted_mfe_pips:
                md.predicted_mfe_pips,

            ml_threshold_pips:
                md.ml_threshold_pips,

            ml_gate:
                md.ml_gate,

            decision:
                status === "FILLED"
                    ? "TRADE"
                    : (
                        status
                            ? "ORDER " + status
                            : "ORDER ATTEMPT"
                    ),

            reason:
                o.reason ||
                o.error ||
                (
                    status === "FILLED"
                        ? "Practice order filled"
                        : "See NewsBot order log"
                )
        };
    }


    const trades=(n.trades||[]).slice().reverse();

    if(trades.length){

        const t=trades[0]||{};
        const md=t.metadata||{};

        return {
            decision_time_utc:
                t.open_time_utc ||
                t.close_time_utc ||
                md.feed_received_utc,

            scheduled_time_utc:
                md.scheduled_time_utc,

            currency:
                md.currency,

            event_name:
                md.event_name,

            actual:
                md.actual,

            forecast:
                md.forecast,

            previous:
                md.previous,

            surprise:
                md.surprise,

            currency_bias:
                md.currency_bias,

            selected_pair:
                t.instrument,

            side:
                t.side,

            entry_spread_pips:
                md.entry_spread_pips,

            price_age_ms:
                md.price_age_ms,

            schedule_to_detection_ms:
                md.schedule_to_detection_ms,

            decision_ms:
                md.decision_ms,

            order_request_ms:
                t.order_request_ms,

            ml_status:
                md.ml_status ||
                "NOT ACTIVE YET",

            predicted_mfe_pips:
                md.predicted_mfe_pips,

            ml_threshold_pips:
                md.ml_threshold_pips,

            ml_gate:
                md.ml_gate,

            decision:
                "TRADE",

            reason:
                "Completed practice trade - " +
                (
                    t.exit_reason ||
                    "closed"
                )
        };
    }

    return null;
}


function newsDecisionRow(label,value,c=''){
    return `
        <div class="newsdecisionrow">
            <span>${esc(label)}</span>
            <strong class="${c}">${value}</strong>
        </div>
    `;
}


function renderNewsDecision(n){

    const box=$('#newsdecision');

    if(!box){
        return;
    }

    const d=newsDecisionSnapshot(n);

    if(!d){

        $('#newsdecisionstatus').textContent =
            'Waiting for a processed release';

        box.className =
            'card newsdecisioncard';

        box.innerHTML=`
            <div class="newsoffline">
                <strong>No NewsBot decision available yet</strong>
                <div class="sub">
                    The panel is ready for the next processed release.
                    ML fields will populate when the new ML engine is connected.
                </div>
            </div>
        `;

        $('#newsdecisionbody').innerHTML=`
            <tr>
                <td colspan="12" class="empty">
                    No NewsBot decisions recorded yet.
                </td>
            </tr>
        `;

        $('#newsdecisionhistorysummary').textContent =
            'Decision audit trail';

        return;
    }


    const decision=String(
        d.final_decision ||
        d.decision ||
        'UNKNOWN'
    ).toUpperCase();

    const isNoTrade=
        decision.includes('NO TRADE') ||
        decision.includes('REJECT') ||
        decision.includes('ERROR') ||
        decision.includes('FAIL');

    const isTrade=
        !isNoTrade &&
        (
            decision === 'TRADE' ||
            decision.includes('FILLED')
        );

    const stateClass=
        isTrade
            ? 'trade'
            : (
                isNoTrade
                    ? 'notrade'
                    : ''
            );

    const pillClass=
        isTrade
            ? 'released'
            : (
                isNoTrade
                    ? 'rejected'
                    : 'waiting'
            );

    const ml=d.ml||{};

    const mlStatus=String(
        d.ml_status ||
        ml.status ||
        'NOT ACTIVE YET'
    ).toUpperCase();

    const predicted=
        d.predicted_mfe_pips ??
        ml.predicted_mfe_pips;

    const threshold=
        d.ml_threshold_pips ??
        d.predicted_mfe_threshold ??
        ml.threshold_pips;

    const mlGate=String(
        d.ml_gate ||
        ml.gate ||
        (
            mlStatus === 'ACTIVE'
                ? 'NOT EVALUATED'
                : 'NOT ACTIVE'
        )
    ).toUpperCase();

    let margin=null;

    if(
        predicted !== null &&
        predicted !== undefined &&
        threshold !== null &&
        threshold !== undefined &&
        Number.isFinite(Number(predicted)) &&
        Number.isFinite(Number(threshold))
    ){
        margin=
            Number(predicted) -
            Number(threshold);
    }

    const eventName=
        d.event_name ||
        d.event ||
        'Economic release';

    const currency=
        d.currency ||
        '';

    const pair=
        d.selected_pair ||
        d.instrument ||
        d.pair ||
        '--';

    const side=
        d.side ||
        d.trade_side ||
        '--';

    const reason=
        d.reason ||
        d.final_reason ||
        d.skip_reason ||
        'No explanation recorded';

    const numericPass=
        d.actual !== null &&
        d.actual !== undefined &&
        d.forecast !== null &&
        d.forecast !== undefined;

    const mlGateClass=
        mlGate === 'PASS'
            ? 'pass'
            : (
                mlGate === 'FAIL'
                    ? 'fail'
                    : 'wait'
            );

    $('#newsdecisionstatus').textContent =
        decision;

    box.className =
        'card newsdecisioncard ' +
        stateClass;

    box.innerHTML=`
        <div class="newsdecisiontop">
            <div>
                <div class="newsdecisionevent">
                    ${esc(currency)} ${currency?' - ':''}${esc(eventName)}
                </div>

                <div class="newsdecisionmeta">
                    Scheduled ${when(d.scheduled_time_utc)}
                    ${d.decision_time_utc
                        ? ' | Decision ' + when(d.decision_time_utc)
                        : ''}
                </div>
            </div>

            <span class="newsstatus ${pillClass}">
                ${esc(decision)}
            </span>
        </div>


        <div class="newsdecisionsections">

            <div class="newsdecisionsection">

                <h3>Economic Release</h3>

                <div class="newsdecisionrows">

                    ${newsDecisionRow(
                        'Actual',
                        esc(d.actual ?? '--')
                    )}

                    ${newsDecisionRow(
                        'Forecast',
                        esc(d.forecast ?? '--')
                    )}

                    ${newsDecisionRow(
                        'Previous',
                        esc(d.previous ?? '--')
                    )}

                    ${newsDecisionRow(
                        'Surprise',
                        newsDecisionMaybe(
                            d.surprise,
                            4
                        )
                    )}

                    ${newsDecisionRow(
                        'Currency Bias',
                        esc(
                            d.currency_bias ||
                            d.bias ||
                            '--'
                        )
                    )}

                </div>
            </div>


            <div class="newsdecisionsection">

                <h3>ML Decision</h3>

                <div class="newsdecisionrows">

                    ${newsDecisionRow(
                        'ML Status',
                        esc(mlStatus),
                        mlStatus === 'ACTIVE'
                            ? 'pos'
                            : 'warn'
                    )}

                    ${newsDecisionRow(
                        'Predicted MFE',
                        newsDecisionMaybe(
                            predicted,
                            2,
                            ' p'
                        )
                    )}

                    ${newsDecisionRow(
                        'Required MFE',
                        newsDecisionMaybe(
                            threshold,
                            2,
                            ' p'
                        )
                    )}

                    ${newsDecisionRow(
                        'Margin',
                        margin === null
                            ? '--'
                            : newsDecisionMaybe(
                                margin,
                                2,
                                ' p'
                            ),
                        margin === null
                            ? ''
                            : cls(margin)
                    )}

                    ${newsDecisionRow(
                        'ML Gate',
                        esc(mlGate),
                        mlGate === 'PASS'
                            ? 'pos'
                            : (
                                mlGate === 'FAIL'
                                    ? 'neg'
                                    : 'warn'
                            )
                    )}

                </div>
            </div>


            <div class="newsdecisionsection">

                <h3>Market / Execution</h3>

                <div class="newsdecisionrows">

                    ${newsDecisionRow(
                        'Selected Pair',
                        esc(pair)
                    )}

                    ${newsDecisionRow(
                        'Side',
                        esc(side)
                    )}

                    ${newsDecisionRow(
                        'Entry Spread',
                        newsDecisionMaybe(
                            d.entry_spread_pips,
                            2,
                            ' p'
                        )
                    )}

                    ${newsDecisionRow(
                        'Price Age',
                        newsDecisionMaybe(
                            d.price_age_ms,
                            0,
                            ' ms'
                        )
                    )}

                    ${newsDecisionRow(
                        'FF Detection',
                        newsDecisionMaybe(
                            d.schedule_to_detection_ms,
                            0,
                            ' ms'
                        )
                    )}

                    ${newsDecisionRow(
                        'Decision Time',
                        newsDecisionMaybe(
                            d.decision_ms,
                            2,
                            ' ms'
                        )
                    )}

                    ${newsDecisionRow(
                        'ML Feature Build',
                        newsDecisionMaybe(
                            d.ml_feature_ms ??
                            ml.feature_ms,
                            2,
                            ' ms'
                        )
                    )}

                    ${newsDecisionRow(
                        'ML Inference',
                        newsDecisionMaybe(
                            d.ml_inference_ms ??
                            ml.inference_ms,
                            2,
                            ' ms'
                        )
                    )}

                    ${newsDecisionRow(
                        'OANDA Order',
                        newsDecisionMaybe(
                            d.order_request_ms,
                            2,
                            ' ms'
                        )
                    )}

                </div>
            </div>

        </div>


        <div class="newsgates">

            <span class="newsgate pass">
                PRACTICE ACCOUNT
            </span>

            <span class="newsgate ${numericPass?'pass':'wait'}">
                NUMERIC RELEASE
            </span>

            <span class="newsgate ${mlGateClass}">
                ML ${esc(mlGate)}
            </span>

            <span class="newsgate ${pair!=='--'?'pass':'wait'}">
                MARKET SELECTION
            </span>

            <span class="newsgate ${isTrade?'pass':(isNoTrade?'fail':'wait')}">
                FINAL GATE
            </span>

        </div>


        <div class="newsdecisionfinal ${stateClass}">

            <div class="newsdecisionfinalhead">

                <span>Final Decision</span>

                <strong class="${
                    isTrade
                        ? 'pos'
                        : (
                            isNoTrade
                                ? 'neg'
                                : 'warn'
                        )
                }">
                    ${esc(decision)}
                </strong>

            </div>

            <div class="newsdecisionreason">
                ${esc(reason)}
            </div>

        </div>
    `;


    let history=Array.isArray(n.decisions)
        ? n.decisions.slice().reverse()
        : [];

    if(!history.length){
        history=[d];
    }

    history=history.slice(0,50);

    $('#newsdecisionhistorysummary').textContent =
        history.length +
        ' decision' +
        (history.length===1?'':'s') +
        ' shown';

    $('#newsdecisionbody').innerHTML=
        history.map(x=>{

            const xml=x.ml||{};

            const xDecision=String(
                x.final_decision ||
                x.decision ||
                'UNKNOWN'
            ).toUpperCase();

            const xNo=
                xDecision.includes('NO TRADE') ||
                xDecision.includes('REJECT') ||
                xDecision.includes('ERROR') ||
                xDecision.includes('FAIL');

            const xClass=
                xNo
                    ? 'neg'
                    : (
                        xDecision === 'TRADE' ||
                        xDecision.includes('FILLED')
                            ? 'pos'
                            : 'warn'
                    );

            const xPred=
                x.predicted_mfe_pips ??
                xml.predicted_mfe_pips;

            const xThresh=
                x.ml_threshold_pips ??
                x.predicted_mfe_threshold ??
                xml.threshold_pips;

            return `
                <tr>

                    <td>
                        ${when(
                            x.decision_time_utc ||
                            x.recorded_utc ||
                            x.feed_received_utc ||
                            x.scheduled_time_utc
                        )}
                    </td>

                    <td>
                        <b>${esc(x.currency||'--')}</b>
                    </td>

                    <td>
                        ${esc(
                            x.event_name ||
                            x.event ||
                            '--'
                        )}
                    </td>

                    <td>
                        ${esc(x.actual??'--')}
                    </td>

                    <td>
                        ${esc(x.forecast??'--')}
                    </td>

                    <td>
                        ${esc(
                            x.currency_bias ||
                            x.bias ||
                            '--'
                        )}
                    </td>

                    <td>
                        ${newsDecisionMaybe(
                            xPred,
                            1,
                            ' p'
                        )}
                    </td>

                    <td>
                        ${newsDecisionMaybe(
                            xThresh,
                            1,
                            ' p'
                        )}
                    </td>

                    <td>
                        <b>${esc(
                            x.selected_pair ||
                            x.instrument ||
                            x.pair ||
                            '--'
                        )}</b>
                    </td>

                    <td>
                        ${esc(
                            x.side ||
                            x.trade_side ||
                            '--'
                        )}
                    </td>

                    <td class="${xClass}">
                        <b>${esc(xDecision)}</b>
                    </td>

                    <td>
                        ${esc(
                            x.reason ||
                            x.final_reason ||
                            x.skip_reason ||
                            '--'
                        )}
                    </td>

                </tr>
            `;

        }).join('');
}

function renderNews(){
    renderNewsDecision(NEWS || {});


    const n=NEWS||{};
    const cal=n.calendar||{};
    const rt=n.runtime||{};
    const sum=n.summary||{};
    const rows=cal.high_impact_rows||[];
    const trades=(n.trades||[]).slice().reverse();
    const active=n.active_trade||null;

    const runtimeAge=
        n.bridge_generated_utc
        ? (
            Date.now()
            -new Date(
                n.bridge_generated_utc
            ).getTime()
        )/1000
        : Infinity;

    const live=
        runtimeAge<180;

    $('#newsbadges').innerHTML=
        '<span class="pill '
        +(live?'good':'bad')
        +'">'
        +(live?'NEWS FEED LIVE':'NEWS FEED STALE')
        +'</span>'
        +'<span class="pill info">'
        +(rt.mode||'PRACTICE')
        +'</span>'
        +'<span class="pill '
        +(active?'good':'')
        +'">'
        +(active?'TRADE OPEN':'NO OPEN TRADE')
        +'</span>';

    const units=
        newsNum(
            rt.units,
            0
        );

    const lots=
        Number.isFinite(
            Number(rt.lots)
        )
        ? Number(rt.lots)
        : (
            units
            ? units/100000
            : 0
        );

    $('#newsstats').innerHTML=

        metric(
            'Trade Size',
            lots
                ? fmt(lots,2)+' lot'
                : '?',
            units
                ? fmt(units,0)+' units'
                : 'Waiting for runtime'
        )

        +

        metric(
            'High Impact',
            String(rows.length),
            (sum.released_events||0)
            +' released / '
            +(sum.waiting_events||0)
            +' waiting'
        )

        +

        metric(
            'Completed Trades',
            String(
                sum.closed_trades||0
            ),
            (sum.wins||0)
            +' wins / '
            +(sum.losses||0)
            +' losses'
        )

        +

        metric(
            'Win Rate',
            newsMaybe(
                sum.win_rate,
                1,
                '%'
            ),
            'News G2 trades'
        )

        +

        metric(
            'Net Pips',
            newsMaybe(
                sum.net_pips,
                1,
                ' p'
            ),
            'PF '
            +newsMaybe(
                sum.profit_factor,
                2
            ),
            cls(
                sum.net_pips
            )
        )

        +

        metric(
            'Avg Detection',
            newsMaybe(
                sum.avg_detection_ms,
                0,
                ' ms'
            ),
            'Schedule to detection'
        );


    $('#newscalendarupdated')
        .textContent=
        cal.captured_utc
        ? 'Snapshot '
          +when(
              cal.captured_utc
          )
        : 'Waiting for snapshot';


    $('#newscalendarbody')
        .innerHTML=
        rows.length

        ? rows.map(
            x=>{

                const actual=
                    String(
                        x.actual??''
                    ).trim();

                const status=
                    actual
                    ? 'RELEASED'
                    : 'WAITING';

                return (
                    '<tr>'

                    +'<td>'
                    +esc(
                        x.date_text
                        ||x.date
                        ||'?'
                    )
                    +'</td>'

                    +'<td>'
                    +esc(
                        x.time_text
                        ||x.time
                        ||'?'
                    )
                    +'</td>'

                    +'<td><b>'
                    +esc(
                        x.currency||''
                    )
                    +'</b></td>'

                    +'<td>'
                    +esc(
                        x.event_name
                        ||x.event
                        ||''
                    )
                    +'</td>'

                    +'<td class="'
                    +(actual?'pos':'')
                    +'">'
                    +esc(
                        actual||'?'
                    )
                    +'</td>'

                    +'<td>'
                    +esc(
                        x.forecast||'?'
                    )
                    +'</td>'

                    +'<td>'
                    +esc(
                        x.previous||'?'
                    )
                    +'</td>'

                    +'<td><span class="newsstatus '
                    +(actual
                        ?'released'
                        :'waiting')
                    +'">'
                    +status
                    +'</span></td>'

                    +'</tr>'
                );
            }
        ).join('')

        : (
            '<tr>'
            +'<td colspan="8" class="empty">'
            +'No high-impact events '
            +'in the current snapshot'
            +'</td>'
            +'</tr>'
        );


    if(active){

        const md=
            active.metadata||{};

        const pips=
            newsNum(
                active.current_pips,
                0
            );

        const pl=
            active.unrealized_pl;

        const side=
            String(
                active.side||''
            ).toUpperCase();

        $('#newsactivestatus')
            .textContent=
            'LIVE PRACTICE TRADE';

        $('#newsactivetrade')
            .className=
            'card newslive';

        $('#newsactivetrade')
            .innerHTML=

            '<div class="newstradehead">'

            +'<div>'

            +'<div class="newstradepair">'
            +esc(
                active.instrument||'?'
            )
            +' '
            +esc(side)
            +'</div>'

            +'<div class="sub">'
            +esc(
                md.currency||''
            )
            +' ? '
            +esc(
                md.event_name||''
            )
            +'</div>'

            +'</div>'

            +'<span class="newsstatus open">'
            +'LIVE PRACTICE'
            +'</span>'

            +'</div>'

            +'<div class="newstrademetrics">'

            +'<div class="mini">'
            +'<span>Entry</span><strong>'
            +newsMaybe(
                active.entry_price,
                5
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>Current</span><strong>'
            +newsMaybe(
                active.current_price,
                5
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>Current pips</span>'
            +'<strong class="'
            +cls(pips)
            +'">'
            +newsMaybe(
                pips,
                1,
                ' p'
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>Open P/L</span>'
            +'<strong class="'
            +cls(pl)
            +'">'
            +(pl==null
                ?'?'
                :money(pl))
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>TP</span><strong>'
            +newsMaybe(
                active.tp_price,
                5
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>SL</span><strong>'
            +newsMaybe(
                active.sl_price,
                5
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>MFE</span><strong>'
            +newsMaybe(
                active.mfe_pips,
                1,
                ' p'
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>MAE</span><strong>'
            +newsMaybe(
                active.mae_pips,
                1,
                ' p'
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>Time open</span><strong>'
            +newsDuration(
                active.elapsed_seconds
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>Spread</span><strong>'
            +newsMaybe(
                active.current_spread_pips,
                2,
                ' p'
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>Detection</span><strong>'
            +newsMaybe(
                md.schedule_to_detection_ms,
                0,
                ' ms'
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>Order</span><strong>'
            +newsMaybe(
                active.order_request_ms,
                0,
                ' ms'
            )
            +'</strong></div>'

            +'</div>'

            +'<div class="newseventbox">'

            +'<strong>'
            +esc(
                md.event_name
                ||'Economic release'
            )
            +'</strong>'

            +'<div class="newseventmeta">'

            +'<div class="mini">'
            +'<span>Actual</span><strong>'
            +esc(
                md.actual??'?'
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>Forecast</span><strong>'
            +esc(
                md.forecast??'?'
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>Previous</span><strong>'
            +esc(
                md.previous??'?'
            )
            +'</strong></div>'

            +'<div class="mini">'
            +'<span>Surprise</span><strong>'
            +newsMaybe(
                md.surprise,
                4
            )
            +'</strong></div>'

            +'</div>'
            +'</div>';

    }
    else{

        $('#newsactivestatus')
            .textContent=
            'No active trade';

        $('#newsactivetrade')
            .className=
            'card';

        $('#newsactivetrade')
            .innerHTML=
            '<div class="newsoffline">'
            +'<strong>No active NewsBot trade</strong>'
            +'<div class="sub">'
            +'Next eligible high-impact release '
            +'can populate this panel.'
            +'</div>'
            +'</div>';
    }


    $('#newstradesummary')
        .textContent=
        (sum.closed_trades||0)
        +' closed ? '
        +newsMaybe(
            sum.net_pips,
            1,
            ' p'
        )
        +' net';


    $('#newstradebody')
        .innerHTML=
        trades.length

        ? trades.slice(
            0,
            100
        ).map(
            t=>{

                const md=
                    t.metadata||{};

                return (
                    '<tr>'

                    +'<td>'
                    +when(
                        t.close_time_utc
                    )
                    +'</td>'

                    +'<td>'
                    +esc(
                        md.event_name||'?'
                    )
                    +'</td>'

                    +'<td><b>'
                    +esc(
                        t.instrument||'?'
                    )
                    +'</b></td>'

                    +'<td>'
                    +esc(
                        t.side||'?'
                    )
                    +'</td>'

                    +'<td>'
                    +newsMaybe(
                        t.entry_price,
                        5
                    )
                    +'</td>'

                    +'<td>'
                    +newsMaybe(
                        t.exit_price,
                        5
                    )
                    +'</td>'

                    +'<td class="'
                    +cls(
                        t.result_pips
                    )
                    +'">'
                    +newsMaybe(
                        t.result_pips,
                        1
                    )
                    +'</td>'

                    +'<td class="'
                    +cls(
                        t.realized_pl
                    )
                    +'">'
                    +(t.realized_pl==null
                        ?'?'
                        :money(
                            t.realized_pl
                        ))
                    +'</td>'

                    +'<td>'
                    +newsMaybe(
                        t.mfe_pips,
                        1
                    )
                    +'</td>'

                    +'<td>'
                    +newsMaybe(
                        t.mae_pips,
                        1
                    )
                    +'</td>'

                    +'<td>'
                    +newsDuration(
                        t.elapsed_seconds
                    )
                    +'</td>'

                    +'<td>'
                    +esc(
                        t.exit_reason||'?'
                    )
                    +'</td>'

                    +'<td>'
                    +newsMaybe(
                        md.schedule_to_detection_ms,
                        0,
                        ' ms'
                    )
                    +'</td>'

                    +'<td>'
                    +newsMaybe(
                        t.order_request_ms,
                        0,
                        ' ms'
                    )
                    +'</td>'

                    +'</tr>'
                );
            }
        ).join('')

        : (
            '<tr>'
            +'<td colspan="14" class="empty">'
            +'No completed NewsBot trades yet'
            +'</td>'
            +'</tr>'
        );
}


async function loadNews(){

    try{

        const r=await fetch(
            'data/news_g2.json?t='
            +Date.now(),
            {
                cache:'no-store'
            }
        );

        if(!r.ok){
            throw new Error(
                'HTTP '+r.status
            );
        }

        NEWS=await r.json();

        $('#newsfeederror')
            .style.display=
            'none';

        renderNews();

    }
    catch(e){

        const box=
            $('#newsfeederror');

        box.style.display=
            'block';

        box.textContent=
            'News G2 data could not be loaded: '
            +e.message
            +' ? start the News G2 dashboard bridge.';

        renderNews();
    }
}


function render(){const d=DATA,a=d.account||{},p=d.prop||{},s=d.summary||{},bot=d.bot||{};$('#subtitle').textContent=`${d.challenge_name||'Practice Challenge'} Ã¢â‚¬Â¢ OANDA ${String(d.environment||'practice').toUpperCase()} Ã¢â‚¬Â¢ ${d.account_mask||'account'}`;$('#livepill').textContent=bot.halted?'BOT HALTED':'BOT RUNNING';$('#livepill').className='pill '+(bot.halted?'bad':'good');$('#tppill').textContent=s.all_tps_protected?'TP PROTECTED':'TP ATTENTION';$('#tppill').className='pill '+(s.all_tps_protected?'good':'bad');$('#updatedpill').textContent='Updated '+when(d.generated_at);
$('#stats').innerHTML=metric('G2 Balance',money(a.balance),'Tracking since Aug 20, 2026')+metric('G2 NAV / Equity',money(a.nav),'G2 balance + current open P/L')+metric('Today P/L',money(a.today_pl),'Realized today + open P/L',cls(a.today_pl))+metric('Open P/L',money(a.unrealized_pl),`${s.open_trades||0} OANDA trades`,cls(a.unrealized_pl))+metric('Open Baskets',`${s.open_baskets||0} / 5`,`${fmt(s.active_allocation||0,3)} / 5.0x allocation`)+metric('Net Pips',fmt(s.net_pips||0,1),`${s.closed_trades||0} closed trades`,cls(s.net_pips));
$('#risks').innerHTML=barCard('Profit Target',p.profit_progress_dollars||0,p.profit_target_dollars||1,`${fmt(p.profit_progress_percent||0,1)}% complete`,'green')+barCard('Daily Loss Room',p.daily_loss_room||0,p.daily_loss_limit_dollars||1,`Limit ${money(p.daily_loss_limit_dollars)}`,p.daily_loss_room<0?'red':'')+barCard('Max Loss Room',p.max_loss_room||0,p.max_loss_limit_dollars||1,`Floor ${money(p.max_loss_floor)}`,p.max_loss_room<0?'red':'')+barCard('Drawdown Room',p.drawdown_room||0,p.max_loss_limit_dollars||1,`Current DD ${fmt(p.current_drawdown_percent||0,2)}%`,p.drawdown_room<0?'red':'');
$('#health').innerHTML=row('Halted',bot.halted?'YES':'NO',bot.halted?'neg':'pos')+row('State saved',when(bot.state_updated_at))+row('Server TP',s.all_tps_protected?'Protected':'Check required',s.all_tps_protected?'pos':'neg')+row('M15 schedule',':01 / :16 / :31 / :46')+row('Fast manager','~5 seconds')+row('Environment',String(d.environment||'practice').toUpperCase());
const eq=d.equity_curve||[];draw('equityChart','line',eq.map(x=>when(x.time)),eq.map(x=>x.equity),'Equity');renderSignalMonitor();renderBaskets();renderAnalytics();renderJournal();renderSystem()}
function renderBaskets(){const bs=DATA.baskets||[];$('#basketcount').textContent=`${bs.length} active`;$('#basketgrid').innerHTML=bs.length?bs.map(b=>`<article class="card basket ${String(b.direction).toLowerCase()}"><div class="baskethead"><div><div class="pair">${esc(b.pair)}</div><div class="sub">Basket ${esc(b.basket_id_short||'')}</div></div><span class="direction ${String(b.direction).toLowerCase()}">${esc(b.direction)}</span></div><div class="basketmetrics"><div class="mini"><span>Current pips</span><strong class="${cls(b.current_pips)}">${fmt(b.current_pips,1)}</strong></div><div class="mini"><span>Open P/L</span><strong class="${cls(b.open_pl)}">${money(b.open_pl)}</strong></div><div class="mini"><span>Target</span><strong>+${fmt(b.target_pips,1)} p</strong></div><div class="mini"><span>Allocation</span><strong>${fmt(b.allocation,3)}x</strong></div><div class="mini"><span>Avg entry</span><strong>${fmt(b.average_entry,5)}</strong></div><div class="mini"><span>Broker price</span><strong>${fmt(b.current_price,5)}</strong></div><div class="mini"><span>Add state</span><strong>${b.adds_state}</strong></div><div class="mini"><span>Age</span><strong>${esc(b.age_text)}</strong></div></div><div class="tpbox ${b.tp_protected?'':'bad'}"><span><b>OANDA Server TP</b><br><small>${b.tp_protected?'All funded core trades protected':'Protection mismatch / missing'}</small></span><strong>${b.server_tp?fmt(b.server_tp,5):'UNSET'}</strong></div><div class="tagrow"><span class="tag">Funded adds ${b.funded_adds}</span><span class="tag">Rejected ${b.rejected_rescues}</span><span class="tag">Distress ${b.distress?'YES':'NO'}</span><span class="tag">Overlay ${b.overlay?'YES':'NO'}</span><span class="tag">${b.trade_ids.length} broker trade(s)</span></div></article>`).join(''):'<div class="card empty">No active Test-C baskets</div>'}
function renderAnalytics(){const s=DATA.summary||{},an=DATA.analytics||{};$('#analyticstats').innerHTML=metric('Win Rate',fmt(s.win_rate||0,1)+'%',`${s.wins||0} wins / ${s.losses||0} losses`)+metric('Profit Factor',fmt(s.profit_factor||0,2),'Gross profit ÃƒÂ· gross loss')+metric('Avg Win',fmt(s.avg_win_pips||0,1)+' pips','Closed trades','pos')+metric('Avg Loss',fmt(s.avg_loss_pips||0,1)+' pips','Closed trades','neg')+metric('Best Trade',fmt(s.best_trade_pips||0,1)+' pips','By pip result','pos')+metric('Worst Trade',fmt(s.worst_trade_pips||0,1)+' pips','By pip result','neg');const m=an.monthly||[];draw('monthlyChart','bar',m.map(x=>x.month),m.map(x=>x.pips),'Pips',m.map(x=>x.pips>=0?'#34d399':'#fb7185'));const pr=(an.pairs||[]).slice(0,10);draw('pairChart','bar',pr.map(x=>x.pair),pr.map(x=>x.pips),'Pips',pr.map(x=>x.pips>=0?'#3bc7ff':'#fb7185'));draw('wlChart','bar',['Wins','Losses'],[s.wins||0,s.losses||0],'Trades',['#34d399','#fb7185']);renderCalendar()}
function renderCalendar(){const days=DATA.analytics?.calendar||[], label=DATA.analytics?.calendar_month||'';$('#calmonth').textContent=label;const map=new Map(days.map(x=>[x.day,x]));let out='';for(let i=1;i<=31;i++){const x=map.get(i);out+=x?`<div class="day ${x.pips>=0?'win':'loss'}"><span class="n">${i}</span><strong class="${cls(x.pips)}">${fmt(x.pips,1)}p</strong><small>${x.trades} trades</small></div>`:`<div class="day"><span class="n">${i}</span></div>`}$('#calendar').innerHTML=out}
function renderJournal(){const q=($('#search')?.value||'').toLowerCase(),lim=Number($('#limit')?.value||50);const tr=(DATA.trades||[]).filter(t=>!q||JSON.stringify(t).toLowerCase().includes(q)).slice(0,lim);$('#tbody').innerHTML=tr.map(t=>`<tr><td>${esc(t.id)}</td><td><b>${esc(t.pair)}</b></td><td>${esc(t.direction)}</td><td>${when(t.open_time)}</td><td>${when(t.close_time)}</td><td>${fmt(t.entry_price,5)}</td><td>${fmt(t.exit_price,5)}</td><td class="${cls(t.pips)}">${fmt(t.pips,1)}</td><td class="${cls(t.pl)}">${money(t.pl)}</td><td>${fmt(t.units,0)}</td></tr>`).join('');$('#mobilejournal').innerHTML=tr.map(t=>`<div class="tradecard"><div class="tradehead"><b>${esc(t.pair)} Ã¢â‚¬Â¢ ${esc(t.direction)}</b><strong class="${cls(t.pl)}">${money(t.pl)}</strong></div><div class="tradegrid"><div class="mini"><span>Pips</span><strong class="${cls(t.pips)}">${fmt(t.pips,1)}</strong></div><div class="mini"><span>Units</span><strong>${fmt(t.units,0)}</strong></div><div class="mini"><span>Opened</span><strong>${when(t.open_time)}</strong></div><div class="mini"><span>Closed</span><strong>${when(t.close_time)}</strong></div></div></div>`).join('')||'<div class="empty">No matching trades</div>'}
function renderSystem(){const b=DATA.bot||{};$('#strategy').innerHTML=row('Policy','G2 | A1 .30 | 10 / 5 / 2')+row('A0 / A1','1.00x / 0.30x')+row('A2 / A3','0.00x / 0.00x state')+row('Max baskets','5')+row('Allocation cap','5.0x')+row('Same-pair overlap','ALLOWED')+row('Position fill','OPEN_ONLY')+row('Catastrophe','D72 / L150 / R35 / PB25');$('#runtime').innerHTML=row('State path',esc(b.state_source||'Ã¢â‚¬â€'))+row('State updated',when(b.state_updated_at))+row('Halted',b.halted?'YES':'NO',b.halted?'neg':'pos')+row('Halt reason',esc(b.halt_reason||'None'))+row('Data generated',when(DATA.generated_at))+row('Environment',String(DATA.environment||'practice').toUpperCase())}
async function load(){try{const r=await fetch('data/dashboard.json?t='+Date.now(),{cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);DATA=await r.json();$('#err').style.display='none';render()}catch(e){$('#err').style.display='block';$('#err').textContent='Dashboard data could not be loaded: '+e.message+' Ã¢â‚¬â€ run Export-TestCDashboard.ps1 first.'}}
document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById(b.dataset.view).classList.add('active')});$('#search').addEventListener('input',()=>DATA&&renderJournal());$('#limit').addEventListener('change',()=>DATA&&renderJournal());load();loadNews();setInterval(load,30000);setInterval(loadNews,2000);
</script>
</body></html>
