<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#07111f">
<title>Test-C G2 Prop Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<style>
:root{--bg:#06101d;--panel:#0c1828;--panel2:#101f33;--line:#20344e;--text:#edf5ff;--muted:#8ea4bf;--cyan:#3bc7ff;--green:#34d399;--red:#fb7185;--amber:#fbbf24;--purple:#a78bfa;--shadow:0 18px 50px rgba(0,0,0,.28)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 10% -10%,rgba(59,199,255,.12),transparent 28%),radial-gradient(circle at 90% 0,rgba(52,211,153,.09),transparent 24%),var(--bg);color:var(--text);font:14px/1.45 Inter,Segoe UI,Arial,sans-serif}.shell{max-width:1480px;margin:auto;padding:22px}.top{display:flex;gap:18px;justify-content:space-between;align-items:center;margin-bottom:18px}.brand h1{margin:0;font-size:clamp(24px,4vw,38px);letter-spacing:-.03em}.brand p{margin:6px 0 0;color:var(--muted)}.statusrow{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.pill{border:1px solid var(--line);background:rgba(255,255,255,.04);padding:7px 10px;border-radius:999px;font-size:12px;font-weight:800}.pill.good{color:var(--green);border-color:rgba(52,211,153,.35);background:rgba(52,211,153,.08)}.pill.bad{color:var(--red);border-color:rgba(251,113,133,.35);background:rgba(251,113,133,.08)}.pill.info{color:var(--cyan);border-color:rgba(59,199,255,.35);background:rgba(59,199,255,.08)}.nav{display:flex;gap:8px;position:sticky;top:8px;z-index:20;padding:8px;background:rgba(6,16,29,.82);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.06);border-radius:16px;margin-bottom:18px}.nav button{flex:1;border:0;border-radius:11px;background:transparent;color:var(--muted);padding:10px;font-weight:800;cursor:pointer}.nav button.active{background:linear-gradient(135deg,rgba(59,199,255,.18),rgba(167,139,250,.15));color:var(--text);box-shadow:inset 0 0 0 1px rgba(59,199,255,.18)}.view{display:none}.view.active{display:block}.grid{display:grid;gap:14px}.stats{grid-template-columns:repeat(6,minmax(0,1fr))}.riskgrid{grid-template-columns:repeat(4,minmax(0,1fr));margin-top:14px}.twocol{grid-template-columns:1.45fr .85fr}.threecol{grid-template-columns:repeat(3,minmax(0,1fr))}.card{background:linear-gradient(180deg,rgba(16,31,51,.96),rgba(9,20,35,.96));border:1px solid rgba(255,255,255,.075);border-radius:18px;padding:16px;box-shadow:var(--shadow)}.metric .label,.kicker{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.09em;font-weight:800}.metric .value{font-size:clamp(20px,2.2vw,30px);font-weight:900;margin-top:5px}.sub{font-size:12px;color:var(--muted);margin-top:4px}.pos{color:var(--green)!important}.neg{color:var(--red)!important}.warn{color:var(--amber)!important}.sectiontitle{display:flex;justify-content:space-between;align-items:end;margin:20px 0 10px}.sectiontitle h2{margin:0;font-size:18px}.sectiontitle span{color:var(--muted);font-size:12px}.bar{height:10px;background:#14263b;border-radius:999px;overflow:hidden;margin-top:12px}.bar>i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--cyan),var(--purple));width:0}.bar.green>i{background:linear-gradient(90deg,#10b981,#6ee7b7)}.bar.red>i{background:linear-gradient(90deg,#fb7185,#fda4af)}.riskline{display:flex;justify-content:space-between;gap:12px;margin-top:9px;font-size:12px}.canvaswrap{height:340px}.health{display:grid;gap:9px}.healthrow{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.06)}.healthrow:last-child{border-bottom:0}.healthrow span:first-child{color:var(--muted)}.basketgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.basket{position:relative;overflow:hidden}.basket:before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:var(--cyan)}.basket.short:before{background:var(--red)}.basket.long:before{background:var(--green)}.baskethead{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.pair{font-size:22px;font-weight:950;letter-spacing:.02em}.direction{font-size:11px;font-weight:900;padding:5px 8px;border-radius:999px}.direction.short{background:rgba(251,113,133,.12);color:var(--red)}.direction.long{background:rgba(52,211,153,.12);color:var(--green)}.basketmetrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:14px}.mini{background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.045);padding:10px;border-radius:12px}.mini span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.05em}.mini strong{display:block;margin-top:3px;font-size:14px}.tpbox{margin-top:12px;padding:11px;border:1px solid rgba(52,211,153,.18);background:rgba(52,211,153,.06);border-radius:13px;display:flex;justify-content:space-between;gap:12px}.tpbox.bad{border-color:rgba(251,113,133,.25);background:rgba(251,113,133,.07)}.tagrow{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.tag{font-size:10px;font-weight:800;padding:5px 7px;border-radius:8px;background:#14263b;color:#b8cae0}.calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px}.day{min-height:76px;padding:8px;border-radius:11px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.05)}.day .n{font-size:10px;color:var(--muted)}.day strong{display:block;margin-top:9px;font-size:13px}.day small{display:block;color:var(--muted);font-size:9px}.day.win{border-color:rgba(52,211,153,.26)}.day.loss{border-color:rgba(251,113,133,.28)}.tablecard{overflow:hidden}.tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}.tools input,.tools select{background:#0a1727;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:9px 10px;outline:none}.tools input{flex:1;min-width:180px}.tablewrap{overflow:auto;max-height:580px}table{width:100%;border-collapse:collapse;min-width:900px}th,td{padding:10px 9px;border-bottom:1px solid rgba(255,255,255,.06);text-align:left;white-space:nowrap}th{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;position:sticky;top:0;background:#0c1828}.mobilejournal{display:none}.tradecard{padding:12px;border-bottom:1px solid rgba(255,255,255,.07)}.tradecard:last-child{border-bottom:0}.tradehead{display:flex;justify-content:space-between}.tradegrid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-top:8px}.empty{text-align:center;padding:35px;color:var(--muted)}.footer{color:var(--muted);font-size:11px;text-align:center;padding:30px 0 80px}.error{background:rgba(251,113,133,.08);border:1px solid rgba(251,113,133,.25);color:#fecdd3;padding:12px;border-radius:12px;margin-bottom:12px;display:none}@media(max-width:1150px){.stats{grid-template-columns:repeat(3,1fr)}.riskgrid{grid-template-columns:repeat(2,1fr)}.twocol,.threecol{grid-template-columns:1fr}.basketgrid{grid-template-columns:1fr}}@media(max-width:700px){body{padding-bottom:70px}.shell{padding:14px}.top{align-items:flex-start}.statusrow{justify-content:flex-start}.top{display:block}.statusrow{margin-top:12px}.nav{position:fixed;left:8px;right:8px;top:auto;bottom:max(8px,env(safe-area-inset-bottom));margin:0;border-radius:16px;z-index:50}.nav button{font-size:10px;padding:9px 3px}.stats{grid-template-columns:repeat(2,1fr)}.riskgrid{grid-template-columns:1fr}.card{padding:13px;border-radius:15px}.basketmetrics{grid-template-columns:repeat(2,1fr)}.canvaswrap{height:260px}.calendar{gap:4px}.day{min-height:61px;padding:5px}.day strong{font-size:10px;margin-top:6px}.day small{font-size:8px}.desktopjournal{display:none}.mobilejournal{display:block}.sectiontitle{margin-top:16px}.brand p{font-size:12px}}@media(max-width:390px){.metric .value{font-size:19px}.stats{gap:8px}.card{padding:11px}.pair{font-size:19px}}

/* SIGNAL_MONITOR_UI_V1 */
.signalmon{margin-top:18px}
.signalhead{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:10px}
.signalhead h2{margin:0;font-size:18px}
.signalhead p{margin:4px 0 0;color:var(--muted);font-size:11px}
.signalstatus{text-align:right}
.signalstatus strong{display:block;font-size:12px}
.signalstatus small{display:block;color:var(--muted);margin-top:3px}
.signalstatus.healthy strong{color:var(--green)}
.signalstatus.warning strong{color:var(--amber)}
.signalstatus.fail strong,.signalstatus.stale strong,.signalstatus.error strong{color:var(--red)}
.signalsummary{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin-bottom:12px}
.signalsummary>div{background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.05);border-radius:12px;padding:10px}
.signalsummary span{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.05em}
.signalsummary strong{display:block;margin-top:4px;font-size:15px}
.signalcols{display:grid;grid-template-columns:1.12fr .88fr;gap:12px}
.signalwatch,.signaldetail{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.05);border-radius:14px;padding:12px}
.signaltitle{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:7px}
.signaltitle span{color:var(--muted);font-size:9px}
.signalrow{display:grid;grid-template-columns:25px 86px minmax(160px,1fr) 115px;gap:8px;align-items:center;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.045)}
.signalrow:last-child{border-bottom:0}
.signalrank{color:var(--muted);font-size:10px}
.signalpair strong,.signalpair span{display:block}
.signalpair strong{font-size:12px}
.signalpair span{font-size:9px;color:var(--muted)}
.signalstage strong{display:inline-flex;font-size:8px;padding:3px 7px;border-radius:999px;background:rgba(142,164,191,.09);color:var(--muted)}
.signalstage strong.watch{color:var(--amber);background:rgba(251,191,36,.08)}
.signalstage strong.close{color:var(--cyan);background:rgba(59,199,255,.08)}
.signalstage strong.triggered{color:var(--green);background:rgba(52,211,153,.08)}
.signalstage strong.alert{color:var(--red);background:rgba(251,113,133,.08)}
.signalstage small{display:block;color:var(--muted);font-size:8px;line-height:1.25;margin-top:4px}
.sigscore{display:grid;grid-template-columns:1fr 30px;gap:6px;align-items:center}
.sigtrack{height:6px;background:#14263b;border-radius:999px;overflow:hidden}
.sigfill{height:100%;background:#64748b;border-radius:999px}
.sigfill.watch{background:var(--amber)}
.sigfill.close{background:var(--cyan)}
.sigfill.triggered{background:var(--green)}
.sigfill.alert{background:var(--red)}
.sigscore b{text-align:right;font-size:10px}
.signaldetails{display:grid;gap:8px}
.signaldetail{padding:10px}
.sigdetailhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.sigdetailhead strong,.sigdetailhead span{display:block}
.sigdetailhead>div:first-child>span{color:var(--muted);font-size:9px}
.sigdetailscore{color:var(--cyan);font-size:19px;font-weight:900}
.sigind{display:grid;grid-template-columns:50px 62px 1fr 58px;gap:6px;padding:5px 0;border-bottom:1px solid rgba(255,255,255,.035);font-size:9px;align-items:center}
.sigind>span:first-child{color:var(--muted)}
.sigthreshold{color:var(--muted)}
.sigflag{text-align:right;color:var(--muted)}
.sigflag.good{color:var(--green)}
.sigfooter{display:grid;gap:4px;margin-top:7px;color:var(--muted);font-size:9px}
@media(max-width:1050px){.signalcols{grid-template-columns:1fr}.signalsummary{grid-template-columns:repeat(3,1fr)}}
@media(max-width:700px){.signalsummary{grid-template-columns:repeat(2,1fr)}.signalhead{display:block}.signalstatus{text-align:left;margin-top:8px}.signalrow{grid-template-columns:20px 70px 1fr}.sigscore{grid-column:3}.sigind{grid-template-columns:48px 58px 1fr}.sigflag{grid-column:3}}


/* NEWS_G2_UI_V1 */

.newshero{
    display:flex;
    justify-content:space-between;
    gap:14px;
    align-items:flex-start;
    margin:2px 0 14px
}

.newshero h2{
    margin:0;
    font-size:20px
}

.newshero p{
    margin:5px 0 0;
    color:var(--muted);
    font-size:12px
}

.newsbadges{
    display:flex;
    gap:7px;
    flex-wrap:wrap;
    justify-content:flex-end
}

.newsgrid{
    display:grid;
    grid-template-columns:
        repeat(6,minmax(0,1fr));
    gap:10px
}

.newslive{
    border-color:
        rgba(52,211,153,.30)
}

.newstradehead{
    display:flex;
    justify-content:space-between;
    gap:12px;
    align-items:flex-start;
    margin-bottom:12px
}

.newstradepair{
    font-size:26px;
    font-weight:950
}

.newstrademetrics{
    display:grid;
    grid-template-columns:
        repeat(6,minmax(0,1fr));
    gap:8px
}

.newseventbox{
    margin-top:12px;
    border:1px solid
        rgba(59,199,255,.15);
    background:
        rgba(59,199,255,.045);
    border-radius:13px;
    padding:12px
}

.newseventmeta{
    display:grid;
    grid-template-columns:
        repeat(4,minmax(0,1fr));
    gap:8px;
    margin-top:10px
}

.newsstatus{
    font-size:10px;
    font-weight:900;
    padding:5px 8px;
    border-radius:999px;
    display:inline-block
}

.newsstatus.waiting{
    color:var(--amber)
}

.newsstatus.released,
.newsstatus.open{
    color:var(--green)
}

.newsstatus.rejected{
    color:var(--red)
}

.newsoffline{
    border:1px dashed
        rgba(142,164,191,.22);
    border-radius:14px;
    padding:24px;
    color:var(--muted);
    text-align:center
}

.newsfootnote{
    color:var(--muted);
    font-size:10px;
    margin-top:8px
}

.news-table table{
    min-width:1120px
}

.news-trades table{
    min-width:1320px
}

@media(max-width:1150px){

    .newsgrid{
        grid-template-columns:
            repeat(3,1fr)
    }

    .newstrademetrics{
        grid-template-columns:
            repeat(3,1fr)
    }

    .newseventmeta{
        grid-template-columns:
            repeat(2,1fr)
    }
}

@media(max-width:700px){

    .newshero{
        display:block
    }

    .newsbadges{
        justify-content:flex-start;
        margin-top:10px
    }

    .newsgrid{
        grid-template-columns:
            repeat(2,1fr)
    }

    .newstrademetrics{
        grid-template-columns:
            repeat(2,1fr)
    }

    .newseventmeta{
        grid-template-columns:1fr
    }
}


/* NEWS_G2_DECISION_UI_V1 */

.newsdecisioncard{
    position:relative;
    overflow:hidden;
}

.newsdecisioncard:before{
    content:"";
    position:absolute;
    left:0;
    top:0;
    bottom:0;
    width:4px;
    background:var(--cyan);
}

.newsdecisioncard.trade:before{
    background:var(--green);
}

.newsdecisioncard.notrade:before{
    background:var(--red);
}

.newsdecisiontop{
    display:flex;
    justify-content:space-between;
    gap:16px;
    align-items:flex-start;
    margin-bottom:14px;
}

.newsdecisionevent{
    font-size:22px;
    font-weight:950;
}

.newsdecisionmeta{
    color:var(--muted);
    font-size:11px;
    margin-top:4px;
}

.newsdecisionsections{
    display:grid;
    grid-template-columns:1.05fr 1fr 1.15fr;
    gap:12px;
}

.newsdecisionsection{
    background:rgba(255,255,255,.025);
    border:1px solid rgba(255,255,255,.055);
    border-radius:14px;
    padding:12px;
}

.newsdecisionsection h3{
    margin:0 0 9px;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.08em;
    color:var(--muted);
}

.newsdecisionrows{
    display:grid;
    gap:0;
}

.newsdecisionrow{
    display:flex;
    justify-content:space-between;
    gap:12px;
    padding:7px 0;
    border-bottom:1px solid rgba(255,255,255,.045);
}

.newsdecisionrow:last-child{
    border-bottom:0;
}

.newsdecisionrow span{
    color:var(--muted);
    font-size:11px;
}

.newsdecisionrow strong{
    text-align:right;
    font-size:12px;
}

.newsdecisionfinal{
    margin-top:12px;
    padding:13px;
    border-radius:13px;
    background:rgba(59,199,255,.05);
    border:1px solid rgba(59,199,255,.14);
}

.newsdecisionfinal.trade{
    background:rgba(52,211,153,.06);
    border-color:rgba(52,211,153,.20);
}

.newsdecisionfinal.notrade{
    background:rgba(251,113,133,.06);
    border-color:rgba(251,113,133,.20);
}

.newsdecisionfinalhead{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
}

.newsdecisionfinalhead span{
    color:var(--muted);
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.08em;
}

.newsdecisionfinalhead strong{
    font-size:18px;
}

.newsdecisionreason{
    color:var(--muted);
    font-size:12px;
    margin-top:7px;
}

.newsgates{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-top:10px;
}

.newsgate{
    font-size:9px;
    font-weight:900;
    padding:5px 7px;
    border-radius:8px;
    background:rgba(142,164,191,.08);
    color:var(--muted);
    border:1px solid rgba(142,164,191,.12);
}

.newsgate.pass{
    color:var(--green);
    border-color:rgba(52,211,153,.18);
    background:rgba(52,211,153,.06);
}

.newsgate.fail{
    color:var(--red);
    border-color:rgba(251,113,133,.18);
    background:rgba(251,113,133,.06);
}

.newsgate.wait{
    color:var(--amber);
    border-color:rgba(251,191,36,.18);
    background:rgba(251,191,36,.06);
}

.newsdecisionhistory table{
    min-width:1350px;
}

@media(max-width:1100px){
    .newsdecisionsections{
        grid-template-columns:1fr;
    }
}

@media(max-width:700px){
    .newsdecisiontop{
        display:block;
    }

    .newsdecisiontop .newsstatus{
        margin-top:10px;
    }

    .newsdecisionevent{
        font-size:19px;
    }
}

</style>
</head>
<body>
<div class="shell">
<div id="err" class="error"></div>
<header class="top"><div class="brand"><h1>TEST-C G2 <span style="color:var(--cyan)">Prop Dashboard</span></h1><p id="subtitle">Generation 2 Ã¢â‚¬Â¢ OANDA Practice Ã¢â‚¬Â¢ read-only monitor</p></div><div class="statusrow"><span id="livepill" class="pill info">LOADING</span><span id="tppill" class="pill">TP CHECK</span><span id="updatedpill" class="pill">Ã¢â‚¬â€</span></div></header>
<nav class="nav"><button class="active" data-view="overview">Overview</button><button data-view="baskets">Baskets</button><button data-view="analytics">Analytics</button><button data-view="news">News G2</button><button data-view="journal">Journal</button><button data-view="system">System</button></nav>
<section id="overview" class="view active"><div id="stats" class="grid stats"></div><div class="grid riskgrid" id="risks"></div><div class="sectiontitle"><h2>Performance & Health</h2><span>Account + strategy monitor</span></div><div class="grid twocol"><div class="card"><div class="kicker">Equity curve</div><div class="canvaswrap"><canvas id="equityChart"></canvas></div></div><div class="card"><div class="kicker">Bot health</div><div id="health" class="health"></div></div></div>
<div id="signalmonitor" class="signalmon"></div>
</section>
<section id="baskets" class="view"><div class="sectiontitle"><h2>Open Baskets</h2><span id="basketcount"></span></div><div id="basketgrid" class="basketgrid"></div></section>
<section id="analytics" class="view"><div id="analyticstats" class="grid stats"></div><div class="sectiontitle"><h2>Trading Analytics</h2><span>Closed trade performance</span></div><div class="grid threecol"><div class="card"><div class="kicker">Monthly pips</div><div class="canvaswrap"><canvas id="monthlyChart"></canvas></div></div><div class="card"><div class="kicker">Pair performance</div><div class="canvaswrap"><canvas id="pairChart"></canvas></div></div><div class="card"><div class="kicker">Wins vs losses</div><div class="canvaswrap"><canvas id="wlChart"></canvas></div></div></div><div class="sectiontitle"><h2>Result Calendar</h2><span id="calmonth"></span></div><div class="card"><div id="calendar" class="calendar"></div></div></section>

<section id="news" class="view">

<div
    id="newsfeederror"
    class="error">
</div>

<div class="newshero">

    <div>

        <h2>NewsBot G2</h2>

        <p>
            High-impact economic releases
            + OANDA practice execution
        </p>

    </div>

    <div
        id="newsbadges"
        class="newsbadges">

        <span class="pill">
            NEWSBOT LOADING
        </span>

    </div>

</div>


<div
    id="newsstats"
    class="newsgrid">
</div>

<div class="sectiontitle">
    <h2>Latest News Decision</h2>
    <span id="newsdecisionstatus">Waiting for a release</span>
</div>

<div id="newsdecision" class="card newsdecisioncard">
    <div class="empty">
        Waiting for the first NewsBot G2 decision.
    </div>
</div>

<div class="sectiontitle">
    <h2>News Decision History</h2>
    <span id="newsdecisionhistorysummary">Decision audit trail</span>
</div>

<div class="card tablecard newsdecisionhistory">
    <div class="tablewrap">
        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Currency</th>
                    <th>Event</th>
                    <th>Actual</th>
                    <th>Forecast</th>
                    <th>Bias</th>
                    <th>ML MFE</th>
                    <th>ML Min</th>
                    <th>Pair</th>
                    <th>Side</th>
                    <th>Decision</th>
                    <th>Reason</th>
                </tr>
            </thead>

            <tbody id="newsdecisionbody">
                <tr>
                    <td colspan="12" class="empty">
                        No NewsBot decisions recorded yet.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>



